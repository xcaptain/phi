<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="PhiCoding.Avalonia.Controls.EllipsisMenu">
  <!--
    A compact "⋮" icon trigger that opens a MenuFlyout. It behaves like an
    icon button — transparent, gaining a subtle chip background on
    :pointerover — but the trigger element is a Border, not a Button:
    transparent + 0-border Buttons in Avalonia 12 have flaky hit-testing
    (only part of their bounds reliably receives clicks; verified here —
    a synthetic pointer press reaches a Border's PointerPressed handler but
    is dropped by a Button's). See also CollapsibleSection, which hit the
    same issue. A Border's full bounds are the stable equivalent.

    The menu is toggled from PointerPressed and kept standalone (not
    Button.Flyout) so the MenuFlyout stays light-dismissed — clicking
    anywhere else closes it.
  -->
  <UserControl.Styles>
    <Style Selector="Border#Trigger:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlBorder}"/>
    </Style>
  </UserControl.Styles>

  <Border x:Name="Trigger"
          CornerRadius="4"
          Padding="6,4"
          MinWidth="28"
          MinHeight="24"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Background="Transparent"
          PointerPressed="OnTriggerPressed">
    <material:MaterialIcon x:Name="Icon"
                           Kind="DotsHorizontal"
                           Width="14"
                           Height="14"
                           Foreground="{DynamicResource TextSecondary}"/>
  </Border>
</UserControl>