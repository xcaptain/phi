<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="PhiCoding.Avalonia.ShellLayout">
  <!--
    Two-pane shell:
      Column 0: 240px sidebar  (New Chat | divider | sessions header |
                                  sessions list | divider | footer)
      Column 1: ContentControl view host (chat page / Models / Providers)

    Pure visual layout — positions, sizes, dividers, labels and the chrome
    buttons exist here. Visual state (hover background, group-mode active
    fill) is applied by ShellView, since the structural tests assert on
    exact brush instances and the toggle visual is intrinsically stateful.
  -->

  <Grid ColumnDefinitions="Auto,*">
    <Border Grid.Column="0" Width="240"
            BorderBrush="{DynamicResource ControlBorder}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Row 0: New Chat -->
        <Button Grid.Row="0" x:Name="NewChatButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="6,3"
                HorizontalContentAlignment="Left"
                HorizontalAlignment="Stretch"
                Margin="8,8,8,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="Plus" Width="16" Height="16"/>
            <TextBlock Text="New Chat" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- Row 1: top divider -->
        <Border Grid.Row="1" Height="1"
                Background="{DynamicResource ControlBorder}"
                Margin="8,0"/>

        <!-- Row 2: sessions header — "会话" label + icon-only toggle pair -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="12,6,8,2">
          <TextBlock Grid.Column="0" Text="会话"
                     FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ByDateButton"
                    FontSize="12" Padding="6,2" CornerRadius="4"
                    Background="Transparent"
                    BorderThickness="1"
                    ToolTip.Tip="By date">
              <material:MaterialIcon Kind="CalendarMonth" Width="14" Height="14"/>
            </Button>
            <Button x:Name="ByWorkspaceButton"
                    FontSize="12" Padding="6,2" CornerRadius="4"
                    Background="Transparent"
                    BorderThickness="1"
                    ToolTip.Tip="By workspace">
              <material:MaterialIcon Kind="Folder" Width="14" Height="14"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Row 3: sessions list. The ItemTemplate (which dispatches on
             entry.Kind between session and workspace rows) is wired in
             ShellView because the rows imperatively subscribe to events
             (rename KeyDown/LostFocus, ⋯ menu clicks). -->
        <ListBox Grid.Row="3" x:Name="SessionsList" Margin="8,4"/>

        <!-- Row 4: bottom divider -->
        <Border Grid.Row="4" Height="1"
                Background="{DynamicResource ControlBorder}"
                Margin="8,0"/>

        <!-- Row 5: footer — Providers. The model picker lives in the prompt
             input's footer toolbar (PromptInputView.BuildModelCombo), so
             no separate Models button is needed in the sidebar. -->
        <Button Grid.Row="5" x:Name="ProvidersButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="6,3"
                HorizontalContentAlignment="Left"
                HorizontalAlignment="Stretch"
                Margin="8,8,8,8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="TuneVariant" Width="14" Height="14"
                                   VerticalAlignment="Center"/>
            <TextBlock Text="Providers" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Right: view host (chat page / Models / Providers). -->
    <ContentControl Grid.Column="1" x:Name="ViewHost"/>
  </Grid>
</UserControl>