<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhiCoding.Avalonia.Components.TranscriptLayout">
  <!--
    Transcript chrome: a scrolling view around a centered reading column.
    The reading column uses a 1:8:1 grid so the side margins scale
    proportionally with the window width (content = 80%, margins = 10%
    each) — wide monitors get generous breathing room, narrow shells stay
    tight. No converters, no bindings; pure layout.

    TranscriptView fills the LinesPanel slot with one Control per ChatLine;
    the dynamic per-line factories (user bubbles, markdown text, thinking
    sections, tool cards) stay in TranscriptView because they're
    intrinsically imperative — each line visual is built on demand and
    patched in place while the model streams.
  -->

  <ScrollViewer Padding="0,16"
                VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,8*,*">
      <StackPanel Grid.Column="1"
                  x:Name="LinesPanel"
                  Spacing="8"
                  Margin="0,4"/>
    </Grid>
  </ScrollViewer>
</UserControl>