<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phi.Avalonia.Desktop2.App"
             xmlns:local="using:Phi.Avalonia.Desktop2"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
  <!-- "Light" ThemeVariant forces FluentTheme light variant for UI-1.
       v2 polish: introduce a Theme.axaml with both Light/Dark ResourceDictionary
       entries + bump back to "Default" so the app follows macOS system
       preference. For now, light-everywhere while we're building chrome. -->

  <Application.DataTemplates>
    <!-- Strong-typed VM → View (see ViewLocator.cs). The original Avalonia
         template's DataTemplate uses reflection, which NativeAOT can't trim;
         our ViewLocator is a closed switch on VM types. -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <!-- Theme-aware resources. Avalonia's FluentTheme doesn't ship a shadow
       color resource, so any elevated surface (the prompt input card, a
       future popover, etc.) needs to reference a color from somewhere.
       Centralising the choice here means views never hardcode a hex
       value, and switching light/dark is a one-line change to the
       per-theme dictionary rather than a sweep across views. The
       `DynamicResource` lookup in PromptInputView follows the active
       ThemeVariant, so a system dark-mode switch flows through. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- 6.25% black: subtle lift on the card surface. -->
          <BoxShadows x:Key="CardShadow">0 2 8 0 #30000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <!-- 40% black: dark mode needs a denser shadow because the
               card surface sits on an already-dark page — a light-mode
               6.25% black disappears entirely. -->
          <BoxShadows x:Key="CardShadow">0 2 8 0 #716c6c00</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Markdown rendering for transcript assistant text. Must load via XAML
         (not AvaloniaXamlLoader.Load(stream)) for NativeAOT — AXML is the
         precompiled binary form, loaded from !AvaloniaResources at runtime. -->
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
    <!-- MaterialIcon is a templated control; without these styles the icons
         render as empty boxes (per the package README 2.0+). -->
    <materialIcons:MaterialIconStyles />

    <!-- Borderless TextBox class. Apply via Classes="borderless" on any
         TextBox that should sit inside an outer card frame. The default
         BorderThickness / Background apply to the TextBox control itself
         (the template's PART_BorderElement binds to these via
         TemplateBinding). The focus state needs the /template/ path
         because FluentTheme's focus styling targets the template's Border
         element directly (TextBox:focus /template/ Border#X) — a plain
         .borderless:focus style on the TextBox control has lower
         specificity and can't win. With the /template/ path our selector
         has 5 specificity parts vs the theme's 4, so the focus accent
         border is overridden. The only visible chrome on focus is the
         blinking caret. Use for the prompt input and any future inline-
         edit field; don't apply to standalone search boxes that DO want
         the focus ring. -->
    <Style Selector="TextBox.borderless">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.borderless:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
