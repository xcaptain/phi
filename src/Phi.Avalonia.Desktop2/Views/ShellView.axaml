<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phi.Avalonia.Desktop2.ViewModels"
             xmlns:views="using:Phi.Avalonia.Desktop2.Views"
             x:Class="Phi.Avalonia.Desktop2.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="280,1,*">
    <views:SidebarView Grid.Column="0" DataContext="{Binding Sidebar}" />
    <GridSplitter Grid.Column="1" Width="1"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" />
  </Grid>
</UserControl>
