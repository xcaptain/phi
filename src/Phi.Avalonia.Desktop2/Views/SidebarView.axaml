<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phi.Avalonia.Desktop2.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Phi.Avalonia.Desktop2.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource LayerFillColorDefaultBrush}">
  <DockPanel LastChildFill="True">

    <!-- Top: New Chat. HorizontalAlignment=Stretch so the button fills the
         280px sidebar. Icon + Text in a horizontal StackPanel so the icon
         left-aligns with the "SESSIONS" header below (same starting x). -->
    <Button DockPanel.Dock="Top"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="12,8"
            Margin="12,12,12,4"
            Command="{Binding NewChatCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="Add" Width="16" Height="16" />
        <TextBlock Text="New Chat" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Sessions header. -->
    <TextBlock DockPanel.Dock="Top"
               Text="SESSIONS"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Margin="20,12,16,4"
               FontSize="11" />

    <!-- Bottom: Providers. -->
    <Button DockPanel.Dock="Bottom"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="12,8"
            Margin="12,4,12,12"
            Command="{Binding ShowProvidersCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="Key" Width="16" Height="16" />
        <TextBlock Text="Providers" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Middle (LastChildFill): empty sessions list placeholder. Plain
         text only — no border, no background. UI-2 swaps for a ListBox. -->
    <TextBlock Text="No sessions yet"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="20" />

  </DockPanel>
</UserControl>
