<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phi.Avalonia.Desktop2.ViewModels"
             xmlns:components="using:Phi.Avalonia.Desktop2.Components"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Phi.Avalonia.Desktop2.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
  <!--
    Sidebar chrome + sessions list. Every color reference is a
    FluentTheme brush via {DynamicResource ...}; no custom palette,
    no converters, no MergedDictionary. The chrome follows whatever
    variant FluentTheme picks for the active ThemeVariant (light vs
    dark system preference).

    Brushes used:
      SystemControlBackgroundChromeMediumBrush — sidebar chrome
                                                   surface (dark
                                                   ~#1F1F1F, light
                                                   ~#E6E6E6)
      SystemControlForegroundBaseHighBrush     — primary text (white
                                                   / black)
      SystemControlForegroundBaseMediumBrush   — secondary text (mute
                                                   d workspace headers)
      SystemControlHighlightListMediumBrush    — selected list row
                                                   background (the
                                                   "elevated row"
                                                   in Fluent design)
      SystemControlHighlightAccentBrush        — accent fill
                                                   (ToggleButton
                                                   checked state,
                                                   combo border)

    FluentTheme Button / ToggleButton bring their own pointerover
    visuals out of the box; we don't need a custom "sidebar-row"
    class or per-button hover styling — that was the whole point of
    dropping our hand-rolled Theme.axaml. The session row's Background
    binding is the one place we override: the IsActive → selected
    brush converter flips between Transparent and the selected brush.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Row 0: New Chat. FluentTheme Button handles pointerover out
         of the box (10% BaseHigh tint that reads as a subtle lift
         on either light or dark). No custom class / selector needed. -->
    <Button Grid.Row="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="12,10"
            Margin="12,12,12,2"
            CornerRadius="6"
            Command="{Binding NewChatCommand}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <mi:MaterialIcon Kind="Add" Width="16" Height="16" />
        <TextBlock Text="New Chat"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      </StackPanel>
    </Button>

    <!-- Row 1: divider. Uses the subtle foreground-medium-low brush as
         a 1-px line. FluentTheme doesn't expose a dedicated "divider"
         brush, but SystemControlForegroundBaseMediumLowBrush is the
         same colour the Fluent list dividers use. -->
    <Border Grid.Row="1"
            Height="1"
            Background="{DynamicResource SystemControlHighlightBaseMediumLowBrush}"
            Margin="12,8" />

    <!-- Row 2: SESSIONS header + ByDate/ByWorkspace toggle pair.
         ToggleButton (NOT Button) — FluentTheme's ToggleButton already
         has accent-fill on IsChecked=true + accent foreground for the
         glyph. We just bind IsChecked TwoWay and Command; no converter
         needed for the visual state. The IsChecked command-parameter
         pair makes the click cycle through GroupMode via SetGroupMode. -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="20,8,12,4">
      <TextBlock Grid.Column="0"
                 Text="SESSIONS"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 VerticalAlignment="Center"
                 FontSize="11" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="2"
                  HorizontalAlignment="Right">
        <ToggleButton Padding="6,2"
                      CornerRadius="4"
                      IsChecked="{Binding ByDateActive, Mode=TwoWay}"
                      ToolTip.Tip="By date"
                      Command="{Binding SetGroupModeCommand}"
                      CommandParameter="{x:Static components:NavModel+GroupMode.ByDate}">
          <mi:MaterialIcon Kind="CalendarMonth" Width="14" Height="14" />
        </ToggleButton>
        <ToggleButton Padding="6,2"
                      CornerRadius="4"
                      IsChecked="{Binding ByWorkspaceActive, Mode=TwoWay}"
                      ToolTip.Tip="By workspace"
                      Command="{Binding SetGroupModeCommand}"
                      CommandParameter="{x:Static components:NavModel+GroupMode.ByWorkspace}">
          <mi:MaterialIcon Kind="Folder" Width="14" Height="14" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- Row 3: entries list. ItemsControl + inline per-kind DataTemplate
         switch. Each session row is a FluentTheme Button whose
         Background binding (via SessionRowBrushes) flips between
         Transparent (idle / hover) and SystemControlHighlightListMedium
         (selected, the Fluent design's "elevated list item"). The row's
         pointerover lift is FluentTheme's built-in 10% BaseHigh tint;
         our Background binding overrides it on the selected row. -->
    <ItemsControl Grid.Row="3" Margin="8,4,8,0" ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="components:NavEntryViewModel">
          <ContentControl Content="{Binding}">
            <ContentControl.DataTemplates>

              <!-- Workspace header row. ForegroundBaseMediumBrush reads
                   as a muted section label. No click / no command —
                   workspace rows are group titles. -->
              <DataTemplate DataType="components:WorkspaceNavEntryViewModel">
                <Border Padding="10,10,8,4">
                  <TextBlock Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
              </DataTemplate>

              <!-- Session row. Background binding flips between
                   Transparent (idle) and SystemControlHighlightListMediumBrush
                   (selected). FluentTheme Button keeps its built-in
                   pointerover tint; the active background overrides
                   it. -->
              <DataTemplate DataType="components:SessionNavEntryViewModel">
                <Button Padding="10,7"
                        Margin="0,1"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{Binding IsActive,Converter={x:Static vm:SidebarViewModel+SessionRowBrushes.Background}}"
                        Command="{Binding $parent[ItemsControl].((vm:SidebarViewModel)DataContext).SelectSessionCommand}"
                        CommandParameter="{Binding SessionId}">
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             FontWeight="{Binding IsActive,Converter={x:Static vm:SidebarViewModel+SessionRowBrushes.FontWeight}}"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>

            </ContentControl.DataTemplates>
          </ContentControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Row 4: Providers (bottom nav row, same FluentTheme Button as
         New Chat — built-in hover lift, no custom class needed). -->
    <Button Grid.Row="4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="12,10"
            Margin="12,2,12,12"
            CornerRadius="6"
            Command="{Binding ShowProvidersCommand}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <mi:MaterialIcon Kind="Key" Width="16" Height="16" />
        <TextBlock Text="Providers"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      </StackPanel>
    </Button>

  </Grid>
</UserControl>