<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phi.Avalonia.Desktop2.Components.ChatLines"
             xmlns:md="using:MarkView.Avalonia"
             x:Class="Phi.Avalonia.Desktop2.Components.ChatLines.AssistantTextLineView"
             x:DataType="vm:AssistantTextLineViewModel">
  <Border Padding="4,4,4,12">
    <md:MarkdownViewer Markdown="{Binding Markdown}" />
  </Border>
</UserControl>
