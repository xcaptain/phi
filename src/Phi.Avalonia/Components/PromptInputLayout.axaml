<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:prompt="using:Phi.Prompt"
             xmlns:picker="using:Phi.Avalonia.Components"
             x:Class="Phi.Avalonia.Components.PromptInputLayout">
  <UserControl.Resources>
    <!--
      Picker dropdown row templates, referenced explicitly via
      ItemTemplate="{StaticResource ...}". The conditional styling
      (header/current/accent, sentinel/dim) is computed by the converters
      in PickerItemStyles — the item records themselves stay UI-agnostic.
    -->
    <DataTemplate x:Key="ModelItemTemplate"
                  DataType="prompt:ModelPickerItem"
                  x:DataType="prompt:ModelPickerItem">
      <TextBlock Text="{Binding Label}"
                 Foreground="{Binding, Converter={x:Static picker:PickerItemStyles.ModelForeground}}"
                 FontWeight="{Binding, Converter={x:Static picker:PickerItemStyles.ModelFontWeight}}"/>
    </DataTemplate>
    <DataTemplate x:Key="WorkspaceItemTemplate"
                  DataType="prompt:WorkspacePickerItem"
                  x:DataType="prompt:WorkspacePickerItem">
      <TextBlock Text="{Binding Label}"
                 Foreground="{Binding, Converter={x:Static picker:PickerItemStyles.WorkspaceForeground}}"
                 FontWeight="{Binding, Converter={x:Static picker:PickerItemStyles.WorkspaceFontWeight}}"/>
    </DataTemplate>
  </UserControl.Resources>
  <!--
    Prompt input shell: a single rounded Border hosting the multi-line
    editor on top and, docked to its bottom, a toolbar holding the model
    picker, the workspace picker (fresh sessions only) and the submit
    button — the classic chat-input layout where everything lives inside
    one box.

    Pure layout. The PromptInputView controller wires behaviour on the
    named controls: the editor's Enter/Esc keys, the pickers'
    ItemsSource/ItemTemplate/SelectionChanged, and the submit button's
    idle/running glyph toggle.
  -->

  <!-- The input sits in the same 1:8:1 reading column as the transcript so
       the box aligns with the conversation content at every window width. -->
  <Grid ColumnDefinitions="*,8*,*">
    <Border Grid.Column="1" x:Name="Shell"
            Margin="0,0,0,12"
            Padding="12,8,10,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlBorder}"
            CornerRadius="12">
      <StackPanel Spacing="0">
      <!-- SukiUI's NoShadow keeps the editor transparent with no border —
           including on focus/pointerover — so it blends into the input
           shell (previously a custom borderless template did this). -->
      <TextBox x:Name="Editor"
               Classes="NoShadow"
               PlaceholderText="Ask Phi anything…"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="48"
               MaxHeight="200"/>
      <DockPanel x:Name="Footer"
                 LastChildFill="True"
                 HorizontalSpacing="8"
                 Margin="0,6,0,0">
        <ComboBox x:Name="ModelCombo"
                  DockPanel.Dock="Left"
                  MinWidth="180" MaxWidth="320"
                  PlaceholderText="Select model"
                  ItemTemplate="{StaticResource ModelItemTemplate}"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="6"/>
        <ComboBox x:Name="WorkspaceCombo"
                  DockPanel.Dock="Left"
                  MinWidth="180" MaxWidth="320"
                  PlaceholderText="Select workspace"
                  ItemTemplate="{StaticResource WorkspaceItemTemplate}"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="6"/>
        <Button x:Name="SubmitButton"
                DockPanel.Dock="Right"
                Background="{DynamicResource Accent}"
                Width="34" Height="34"
                Padding="0"
                CornerRadius="17"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ToolTip.Tip="Submit (Enter)">
          <material:MaterialIcon x:Name="SubmitIcon"
                                 Kind="ArrowUpward"
                                 Width="18" Height="18"
                                 Foreground="{DynamicResource AccentText}"/>
        </Button>
      </DockPanel>
    </StackPanel>
    </Border>
  </Grid>
</UserControl>