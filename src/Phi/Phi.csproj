<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- Explicit assembly name so the produced dll (phi-runtime) doesn't
         collide with Phi.Tui's AssemblyName="phi". The csproj filename is
         Phi.csproj to match the public Phi.* namespace (IDE0130 happy); the
         assembly name is hyphenated to match Phi.Avalonia.Desktop's
         "phi-avalonia" pattern. -->
    <AssemblyName>phi-runtime</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phi.Agent\Phi.Agent.csproj" />
    <ProjectReference Include="..\Phi.Provider\Phi.Provider.csproj" />
    <ProjectReference Include="..\Phi.SchemaGen\Phi.SchemaGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phi.Tests" />
  </ItemGroup>

</Project>