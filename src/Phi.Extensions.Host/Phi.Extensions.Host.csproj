<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Phi.Extensions.Host is the PRIVATE wiring package. Extensions
         (user code) never reference this — they only see Phi.Extensions.
         The composition root (Phi.Tui / Phi.Avalonia.Desktop Program.cs)
         is the only consumer. -->
    <IsPackable>false</IsPackable>
    <!-- CA1710 — ExtensionLoadDiagnostic ends in "Diagnostic" by design
         (it's a structured load failure, not a generic exception). -->
    <NoWarn>$(NoWarn);CA1710</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phi.Extensions\Phi.Extensions.csproj" />
    <ProjectReference Include="..\Phi\Phi.csproj" />
    <!-- BuiltInExtensions.RegisterAll lists the extensions the host
         always loads. The ProjectReference lives here (not on every
         frontend) so CodingPack's AOT visibility has a single owner and
         BuiltInExtensions.cs is the single source of truth for which
         built-ins are registered. -->
    <ProjectReference Include="..\..\extensions\CodingPack\CodingPack.csproj" />
  </ItemGroup>

  <!-- The host package exposes implementation types that aren't part of
       the public extension contract. Tests need access to verify behavior,
       so we use InternalsVisibleTo at the assembly level rather than
       making every type public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Phi.Extensions.Host.Tests" />
    <!-- Frontend composition roots construct ExtensionRuntime directly; their
         assembly names differ from project names (Phi.Tui -> phi,
         Phi.Avalonia.Desktop -> phi-avalonia). -->
    <InternalsVisibleTo Include="phi" />
    <InternalsVisibleTo Include="phi-avalonia" />
    <InternalsVisibleTo Include="Phi.Tests" />
    <InternalsVisibleTo Include="Phi.Avalonia.Tests" />
  </ItemGroup>

</Project>
