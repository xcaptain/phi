<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT. Declared here (not on the command line) so the global
         property doesn't leak into the Roslyn source-generator project
         Phi.SchemaGen (netstandard2.0), which errors with NETSDK1207. -->
    <PublishAot>true</PublishAot>
    <!-- Phi.Avalonia (currently referenced) brings in Avalonia.Controls.DataGrid
         transitively, which itself has IL2104/IL3053 assembly-level trim warnings.
         Acknowledged — the project is going away in Phase 9 (replaced by Phi.Avalonia.Desktop2). -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <RootNamespace>Phi.Avalonia.Desktop</RootNamespace>
    <AssemblyName>phi-avalonia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phi.Avalonia\Phi.Avalonia.csproj" />
  </ItemGroup>

</Project>
