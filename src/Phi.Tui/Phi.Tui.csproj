<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RootNamespace>Phi.Tui</RootNamespace>
    <AssemblyName>phi</AssemblyName>
    <!-- IL2026：项目扩展加载走 AssemblyLoadContext + 反射，本就 trim-unsafe；当前不发布 trimmed binary，warning 是过度保守的产物。 -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="XenoAtom.Terminal.UI" />
    <PackageReference Include="XenoAtom.Terminal.UI.Extensions.Markdown" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phi\Phi.csproj" />
    <ProjectReference Include="..\Phi.Extensions.Host\Phi.Extensions.Host.csproj" />
    <ProjectReference Include="..\..\extensions\CodingPack\CodingPack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phi.Tests" />
  </ItemGroup>

</Project>