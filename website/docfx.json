{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "articles/**.md",
          "blog/**.md",
          "articles/**/toc.yml",
          "blog/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "**/images/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "globalMetadata": {
      "_appTitle": "Phi",
      "_appFooter": "Copyright (c) 2026 Phi contributors. Built with <a href=\"https://dotnet.github.io/docfx/\">DocFX</a>.",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_lang": "zh-cn",
      "_gitUrlPattern": "https://github.com/xiefei/phi/blob/main/{filename}"
    },
    "noRestore": true,
    "KeepFileLink": false
  }
}